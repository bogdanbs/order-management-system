FROM quay.io/strimzi/kafka:1.1.0-kafka-4.3.0
USER root:root
RUN microdnf install -y unzip && \
    mkdir -p /opt/kafka/plugins/debezium-postgres && \
    curl -fsSL https://repo1.maven.org/maven2/io/debezium/debezium-connector-postgres/3.0.0.Final/debezium-connector-postgres-3.0.0.Final-plugin.zip \
         -o /tmp/debezium.zip && \
    unzip /tmp/debezium.zip -d /opt/kafka/plugins/debezium-postgres && \
    rm /tmp/debezium.zip && \
    microdnf remove -y unzip && \
    microdnf clean all
USER 1001
