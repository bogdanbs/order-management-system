apiVersion: v1
kind: Secret
metadata:
  name: orders-db
  namespace: orders
type: Opaque
stringData:
  POSTGRES_USER: orders_user
  POSTGRES_PASSWORD: ${ORDERS_DB_PASSWORD}
  POSTGRES_DB: orders_db
  SPRING_DATASOURCE_URL: "jdbc:postgresql://postgres:5432/orders_db"
  SPRING_DATASOURCE_USERNAME: orders_user
  SPRING_DATASOURCE_PASSWORD: ${ORDERS_DB_PASSWORD}

---
apiVersion: v1
kind: Secret
metadata:
  name: grafana-admin
  namespace: orders
type: Opaque
stringData:
  GF_SECURITY_ADMIN_PASSWORD: ${GRAFANA_ADMIN_PASSWORD}

---
apiVersion: v1
kind: Secret
metadata:
  name: alertmanager-slack
  namespace: orders
type: Opaque
stringData:
  # Slack incoming webhook for alert notifications; leave empty to run without them.
  slack_webhook_url: ${SLACK_WEBHOOK_URL}
