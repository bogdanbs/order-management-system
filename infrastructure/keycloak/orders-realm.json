{
  "realm": "orders",
  "enabled": true,
  "roles": {
    "realm": [
      { "name": "ORDERS_READ" },
      { "name": "ORDERS_WRITE" },
      { "name": "ORDERS_ADMIN" }
    ]
  },
  "clients": [
    {
