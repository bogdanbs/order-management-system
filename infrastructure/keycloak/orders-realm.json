  "users": [
    {
      "username": "demo",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "orders-demo",
          "temporary": false
        }
      ],
      "realmRoles": ["ORDERS_READ", "ORDERS_WRITE"]
    }
  ]
}
